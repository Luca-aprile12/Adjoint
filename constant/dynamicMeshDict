    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// SINTASSI CORRETTA per adjointOptimisationFoam v2312.
// Il morpher gestisce il mesh movement internamente — NON serve
// dynamicFvMesh né motionSolverLibs.
//
// OBBLIGATORIO: un sotto-dizionario con nome dentro
// volumetricBSplinesMotionSolverCoeffs per ogni morphing box.
//
// FASE 2 — Legal box FSAE (aggiornato):
//   X: [-0.95, -0.22]        (tenuti come Phase 1)
//   Y: [ 0.00,  0.87]        (Y_min=0 = piano di simmetria)
//   Z: [ 0.03,  0.50]        <-- MODIFICATO da 0.42 a 0.50
//                                (30 mm da terra, 500 mm da terra)
//
// Scelta nCPs:
//   7x7x4 — come Phase 1 (funzionava bene, sensitivita' non troppo rumorosa).
//   degree 3 richiede MINIMO 4 CPs per direzione → nCPsW=4 e' il minimo.
//   Con confineBoundaryControlPoints true, i CPs sul bordo del box sono
//   bloccati automaticamente. Effetto: il piano di simmetria (Y=0 =
//   V_min della box) e' bloccato senza bisogno di confineVMinCPs esplicito.

solver          volumetricBSplinesMotionSolver;

volumetricBSplinesMotionSolverCoeffs
{
    FW_box                          // nome del morphing box (arbitrario)
    {
        type                cartesian;

        nCPsU               7;      // direzione X (lunghezza)
        nCPsV               7;      // direzione Y (semi-span)
        nCPsW               4;      // direzione Z (altezza)

        degreeU             3;
        degreeV             3;
        degreeW             3;

        controlPointsDefinition     axisAligned;
        lowerCpBounds       (-0.95  0.0   0.03);
        upperCpBounds       (-0.22  0.87  0.50);   // Z_max: 0.42 -> 0.50

        // Nessun blocco globale di direzione: massima flessibilita' su X/Y/Z
        confineUMovement    false;
        confineVMovement    false;
        confineWMovement    false;

        // IMPORTANTE: blocca i CPs sul bordo della box per continuita' C0
        // tra la regione parametrizzata e il resto della mesh. Blocca anche
        // automaticamente il piano di simmetria a Y=0 (= V_min della box).
        confineBoundaryControlPoints true;
    }
}

