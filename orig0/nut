FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];
#include        "../initialConditions"
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           $internalField;
    }
    outlet
    {
        type            calculated;
        value           $internalField;
    }
    ground
    {
        type            nutUSpaldingWallFunction;
        value           $internalField;
    }
    "(side|top)"
    {
        type            symmetryPlane;
    }
    symmetry
    {
	type		symmetry;
    }
    "DP_.*"
    {
        type            nutUSpaldingWallFunction;
        value           $internalField;
    }
}


