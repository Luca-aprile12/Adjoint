Radiator
{
    type            explicitPorositySource;
    active          false;

	explicitPorositySourceCoeffs
    {   
       selectionMode   cellZone; 
       type            DarcyForchheimer;
       cellZone        Porous_Radiator;

       DarcyForchheimerCoeffs
       {
           d   d [0 -2 0 0 0 0 0] (9805062 10000000 10000000);
           f   f [0 -1 0 0 0 0 0] (102 1000 1000);
           //d   (9805062 0 0);
           //f   (102 0 0);

           coordinateSystem
              {
                 type    cartesian;
                 origin  (0 0 0);
                 rotation
                 {
                    type    axes;
                    e1      (0.9975641 0 0.0697565); 
                    e2      (0 1 0);
                 }
              }
       }
    }
}
