FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // --- pressione primal e adjoint: stesse impostazioni ---
    "(p|pa.*)"
    {
        solver           GAMG;
        tolerance        1e-7;
        relTol           0.01;
        smoother         GaussSeidel;
        nPreSweeps       1;
        nPostSweeps      2;
        cacheAgglomeration on;
        agglomerator     faceAreaPair;
        nCellsInCoarsestLevel 1000;
        mergeLevels      1;
    }

    Phi
    {
        $p;
    }

//    ma
//    {
//        solver           PCG;
//        preconditioner   DIC;
//        tolerance        1e-9;
//        relTol           0.01;
//    }

    // --- velocita' primal e adjoint ---
    "(U|Ua.*)"
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-6;
        relTol           0.01;
    }

    k
    {
        solver           smoothSolver;
        smoother         symGaussSeidel;
        tolerance        1e-8;
        relTol           0.001;
        nSweeps          1;
    }

    omega
    {
        solver           smoothSolver;
        smoother         symGaussSeidel;
        tolerance        1e-8;
        relTol           0.001;
        nSweeps          1;
    }
}

SIMPLE
{
    nUCorrectors    3;
    nNonOrthogonalCorrectors 1;
    pRefCell        0;
    pRefValue       0;

    // residualControl rimosso di proposito: lo governa optimisationDict.

    consistent yes;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    // I pattern "pa.*" e "Ua.*" coprono sia pa/Ua sia le forme con suffisso
    // del solver. Non collidono con p e U: richiedono il prefisso di due
    // lettere.
    fields
    {
        p        1.0;
        "pa.*"   0.7;
    }

    equations
    {
        p        1.0;
        U        0.9;
        k        0.9;
        omega    0.9;

        "Ua.*"   0.3;
    }
}

cache
{
    grad(U);
}

